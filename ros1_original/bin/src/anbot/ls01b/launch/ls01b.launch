<launch>
	<arg name="installtype" default="0" />
	<arg name="serial_port" default="/dev/ttyUSB0"/> 
	<arg name="beams_per_degree" default="4"/> 
	
    <node name="ls01b" pkg="ls01b" type="ls01b" output="screen">
　　		<param name="scan_topic" value="scan"/>          #设置激光数据topic名称
　　	    <param name="laser_link" value="laser"/>         #激光坐标
         <param name="zero_as_max" value="false"/>       #设置为true探测不到区域会变成最大值
         <param name="min_as_zero" value="true"/>       # true：探测不到区域为0，false：探测不到区域为inf
		 <param name="angle_disable_min" value="90"/>    # 角度制，从angle_disable_min到angle_disable_max之前的值为0
		 <param name="angle_disable_max" value="270"/>
         <param name="installtype" value="$(arg installtype)"/>    
         <param name="serial_port" value="$(arg serial_port)"/>     #雷达连接的串口
         <param name="beams_per_degree" value="$(arg beams_per_degree)"/>    #每度有几束激光数据
    </node>
</launch>
