<launch>
  <arg name="host" default="192.168.113.107" />
  <arg name="installtype" default="1" />
  <node pkg="lms1xx" name="lms1xx" type="LMS1xx_node" output="screen" respawn="true">
    <param name="host" value="$(arg host)" />
    <param name="installtype" value="$(arg installtype)" />
  </node>
</launch>
