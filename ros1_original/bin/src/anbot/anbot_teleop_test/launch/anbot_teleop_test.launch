<launch>
  <node pkg="anbot_teleop_test" type="turtlebot_teleop_key" name="anbot_teleop_test"  output="screen">
    <param name="scale_linear" value="0.1" type="double"/>
    <param name="scale_angular" value="0.5" type="double"/>
    <remap from="/anbot_teleop_test/cmd_vel" to="/anbot_cmd_vel"/>
  </node>
</launch>
