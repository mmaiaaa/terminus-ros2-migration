<?xml version="1.0" encoding="utf-8"?>
<robot name="anbot_mobile_base" xmlns:xacro="http://ros.org/wiki/xacro">
    <!--PRODUCT_TYPE:APV2D-->
    <!-- Macro for Anbot body. Including Gazebo extensions, but does not include Kinect -->
    <xacro:include filename="$(find anbot_model_config)/urdf/property/common_properties.urdf.xacro" />
    
    <xacro:macro name="anbot_mobile_base">
        <link name="base_footprint" />
        <joint name="base_joint" type="fixed">
            <origin xyz="0 0 0.0102" rpy="0 0 0" />
            <parent link="base_footprint" />
            <child link="base_link" />
        </joint>
        <link name="base_link">
            <visual>
                <geometry>
                    <box size="0.8 0.59 0.1" />
                </geometry>
                <origin xyz="-0.15 0 0.05199" rpy="0 0 0" />
            </visual>
            <collision>
                <geometry>
                    <cylinder length="0.10938" radius="0.178" />
                </geometry>
                <origin xyz="0.0 0 0.15949" rpy="0 0 0" />
            </collision>
            <inertial>
                <origin xyz="0.01 0 0" />
                <mass value="2.4" />
                <inertia ixx="0.019995" ixy="0.0" ixz="0.0" iyy="0.019995" iyz="0.0" izz="0.03675" />
            </inertial>
        </link>
        
        <!--anbot_pcl2scan:-->
        <joint name="laser" type="fixed">
            <parent link="base_link" />
            <child link="laser" />
            <origin xyz=" 0.20 0.0 0.42" />
        </joint>
        <link name="laser">
            <visual>
                <geometry>
                    <!--mesh filename="package://anbot_model_config/meshes/RPLIDAR-A1M1R1_withmotor.STL" scale=" 0.001 0.001 0.001"/-->
                    <cylinder length="0.10938" radius="0.05" />
                </geometry>
                <material name="Grey" />
            </visual>
        </link>
        
        <!--rslidar
        <link name="rslidar">
            <visual>
                <geometry>
                    <cylinder length="0.05" radius="0.04"></cylinder>
                </geometry>
                <material name="Grey" />
            </visual>
        </link>
        <joint name="rslidar_joint" type="fixed">
            <parent link="base_link" />
            <child link="rslidar" />
            <origin xyz="0.2 0.0 0.42" rpy="0 0 0" />
        </joint>
        -->

        <!--sonar-->
        <joint name="sonar_0" type="fixed">
            <origin xyz="-0.260 0.349 0.489" rpy="0 0 2.04258" />
            <parent link="base_link" />
            <child link="sonar_0" />
        </joint>
        <link name="sonar_0">
            <visual>
                <geometry>
                    <box size="0.02 0.02 0.02" />
                </geometry>
                <material name="blue">
                    <color rgba="0 0 1 1" />
                </material>
            </visual>
        </link>
        <joint name="sonar_1" type="fixed">
            <origin xyz="-0.348 0.261 0.330" rpy="0 0 2.04258" />
            <parent link="base_link" />
            <child link="sonar_1" />
        </joint>
        <link name="sonar_1">
            <visual>
                <geometry>
                    <box size="0.02 0.02 0.02" />
                </geometry>
                <material name="black" />
            </visual>
        </link>
        <joint name="sonar_2" type="fixed">
            <origin xyz="-0.427 0.155 0.346" rpy="0 0 2.75777" />
            <parent link="base_link" />
            <child link="sonar_2" />
        </joint>
        <link name="sonar_2">
            <visual>
                <geometry>
                    <box size="0.02 0.02 0.02" />
                </geometry>
                <material name="black" />
            </visual>
        </link>
        <joint name="sonar_3" type="fixed">
            <origin xyz="-0.427 -0.155 0.346" rpy="0 0 -2.75777" />
            <parent link="base_link" />
            <child link="sonar_3" />
        </joint>
        <link name="sonar_3">
            <visual>
                <geometry>
                    <box size="0.02 0.02 0.02" />
                </geometry>
                <material name="black" />
            </visual>
        </link>
        <joint name="sonar_4" type="fixed">
            <origin xyz="-0.348 -0.261 0.330" rpy="0 0 -2.04258" />
            <parent link="base_link" />
            <child link="sonar_4" />
        </joint>
        <link name="sonar_4">
            <visual>
                <geometry>
                    <box size="0.02 0.02 0.02" />
                </geometry>
                <material name="black" />
            </visual>
        </link>
        <joint name="sonar_5" type="fixed">
            <origin xyz="-0.260 -0.349 0.489" rpy="0 0 -2.04258" />
            <parent link="base_link" />
            <child link="sonar_5" />
        </joint>
        <link name="sonar_5">
            <visual>
                <geometry>
                    <box size="0.02 0.02 0.02" />
                </geometry>
                <material name="black" />
            </visual>
        </link>
        <!--gps-->
        <joint name="gps" type="fixed">
            <origin xyz="-0.545 0 1.0" rpy="0 -2.0716 3.1415926" />
            <parent link="base_link" />
            <child link="gps" />
        </joint>
        <link name="gps">
            <visual>
                <geometry>
                    <box size="0.04 0.04 0.04" />
                </geometry>
                <material name="red" />
            </visual>
        </link>
    </xacro:macro>
</robot>
