<package>
  <name>legs2dscan_immekf_gnntracker</name>
  <version>1.0.8</version>
  <description>
    Legs2dscan'Nearest-neighbor person tracker 'srl_nearest_neighbor_tracker '(excl'spensor_diagnostics)'subscribes to 'msg: spencer_tracking_msgs/DetectedPersons ,converts them to Observations, calls the tracker's processCycle() 'wn'src, get Tracks as msg' spencer_tracking_msgs/TrackedPersons.
  </description>

  <maintainer email="linder@cs.uni-freiburg.de">Timm Linder</maintainer>

  <license>BSD</license>

  <author>Timm Linder</author>
  <author>Fabian Girrbach</author>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>tf</build_depend>
  <build_depend>spencer_tracking_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>eigen_conversions</build_depend>
  <build_depend>tf_conversions</build_depend>
  <build_depend>cmake_modules</build_depend>
  <build_depend>angles</build_depend>

  <run_depend>tf</run_depend>
  <run_depend>spencer_tracking_msgs</run_depend>
  <run_depend>geometry_msgs</run_depend>
  <run_depend>sensor_msgs</run_depend>
  
  <run_depend>eigen_conversions</run_depend>
  <run_depend>tf_conversions</run_depend>
  <run_depend>angles</run_depend>

<build_depend>roslib</build_depend><run_depend>roslib</run_depend></package>
