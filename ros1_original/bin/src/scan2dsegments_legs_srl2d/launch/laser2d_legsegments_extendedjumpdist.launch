<?xml version="1.0"?>

<launch>

    <!-- roslaunch pclmsg_nongrd_srl2dsegments beiyouRslidar16_xiaoqiang.launch  -->
    <!-- 
	<param name="use_sim_time" value="true"/>
     -->

    <!-- <rosparam file="$(find pkg)/params/param.yaml" command="load"/>
        <node pkg="tf" type="static_transform_publisher" name="base_link_to_rslidar"  args="0 0 0 0 0 0 /base_link /rslidar 100"  / >
    err!! tf 'not appear??
 /pclob/scan
     -->

    <node pkg="scan2dsegments_legs_srl2d" type="scan2dsegments_legs_srl2d_node" name="legs_scan2dsegments_node" output="log">
        <remap from="scan_in" to="/pclob/scan"/>
        <param name="classifier_path" type="string" value="$(find spencer_tracking_msgs)/config/trained_leg_detector.yaml"/> 
        <rosparam>
            # target_frame: rslidar # Leave disabled to output scan in pointcloud frame
            transform_tolerance: 0.01
            min_height: 0.1
            max_height: 1.6
            scan_topic: /scanringraw # /pclob/scan

            angle_min: -3.1415926 # -M_PI
            angle_max: 3.1415926 # M_PI
            angle_increment: 0.003 # 0.002967 rad' # 0.17degree
            # angle_increment: 0.0043633 # 0.25degree
            scan_time: 0.1
            # range_min_scaffold: 0.46 # at deg:
            # range_min_lateral: 0.26
            range_min: 0.835
            range_max: 7.2 # 6.5 vs'8.0+1.0 # 25m # testingWIP
            ensured_leg_prob_thres: 0.8 # 0.6
            people_width_thres: 1.75 # 0.805
            leg_tinywidth_thres: 0.156
            
            use_inf: true
            inf_epsilon: 1.0
            min_segmentwidth_: 0.04
            jumpdist_thres: 0.25 # 0.25 # 0.08

            min_width_legs: 0.1
            max_width_legs: 0.99

            # Concurrency level, affects number of pointclouds queued for processing and number of threads used
            # 0 : Detect number of cores
            # 1 : Single threaded
            # 2->inf : Parallelism level
            concurrency_level: 1
        </rosparam>
    </node>


